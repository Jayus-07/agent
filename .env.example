# ============================================================
# 根 .env 模板 —— 最小可启动集
#
# ⚠️ 这是**唯一生效**的配置文件：backend/config/__init__.py 写死
#    _ENV_PATH = <repo_root>/.env。backend/.env 不会被加载。
#
# 用法:  cp .env.example .env   再把 change_me_* 换成真实值
# 完整变量清单（86 项，逐项注释）见 backend/.env.example
#
# 切勿把真实凭据写进任何被 git 跟踪的文件（本仓库为 PUBLIC）。
# ============================================================

# ---------- 数据库 ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=demo
PGUSER=postgres
PGPASSWORD=change_me
# NL2SQL 执行侧只读角色（6 层安全的第 6 层），由 docker/init-dbs.sh 建号
PG_READONLY_USER=agent_readonly
PG_READONLY_PASSWORD=change_me

# ---------- 网关与身份 ----------
# 本地 dev 必须开启网关，否则前端所有 /api/* 请求失败（前端默认指向 :9080）
GATEWAY_AUTH_ENABLED=true
GATEWAY_AUTH_MODE=enforce          # enforce | warn
# app 只认网关注入的身份头；直连 8000 调试时 chat 身份一律 guest
IDENTITY_SOURCE=header
JWT_SECRET=change_me_at_least_32_chars
JWT_ISSUER=agent-platform
# ⚠️ 生产必须置 false：未配置 API_KEY 时全部端点放行（见 docs/production-readiness-assessment.md）
ALLOW_UNAUTHENTICATED=true

# ---------- 运行模式 ----------
ENV_MODE=cloud                     # cloud | local
# 模型（provider / model / api_key）走 sys_config，由管理端配置；
# 环境变量侧只保留 Ollama 本地推理地址。
OLLAMA_BASE_URL=http://localhost:11434

# ---------- 存储与缓存 ----------
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
# 模型凭据落库前的加密密钥；更换会导致已存的 provider key 无法解密
SECRETS_ENCRYPTION_KEY=change_me

# ---------- 域图开关（代码默认全 false） ----------
CS_ENABLED=false
TRAVEL_ENABLED=false

# ---------- 客服对话体验改造（2026-10-04 任务卡，详见 docs/reports/2026-10-04-客服对话体验改造任务卡.md） ----------
# 独立客服窗口：true=非客服域消息不出域，走出域固定话术（false=旧 redirect_main 转出）
CS_WINDOW_STANDALONE=true
# 寒暄分支：非业务对话走一次 LLM 人设生成（false=回旧漏斗路径）
CS_CHAT_FALLBACK_ENABLED=true
# 寒暄 LLM 单次限时（毫秒，线程级）
CS_CHAT_LLM_TIMEOUT_MS=8000

# POI 候选池数据源：live=腾讯位置服务实时检索（默认，任意城市/零维护）
#                  seed=本地种子库（仅福州/厦门/杭州，已停止维护）
TRAVEL_POI_SOURCE=live
# live 完全失败时是否回退种子库（默认 false：失败如实披露）
TRAVEL_POI_FALLBACK_SEED=false
SELECTION_FUNNEL_ENABLED=false
# 旅游商务/预订（STOP K/L）：代码默认 false；启用需真实供应商契约就位
TRAVEL_COMMERCE_ENABLED=false
TRAVEL_BOOKING_ENABLED=false
TRAVEL_BOOKING_PROVIDER=fake_booking_bare

# ---------- 腾讯位置服务（旅游域实时地图，可选） ----------
TENCENT_LBS_ENABLED=false
TENCENT_LBS_KEY=
TENCENT_LBS_FRONTEND_KEY=

# ---------- 高德开放平台（商家级检索：评分/人均/营业状态，可选） ----------
# Key 须在高德控制台绑定「Web服务」类型；未配置时 map.lookup 的
# merchant_search action 降级返回「未配置」提示，不影响其他地图能力。
AMAP_ENABLED=true
AMAP_KEY=
# 数字签名私钥：仅当控制台为该 Key 开启「数字签名」校验时填写
AMAP_SECRET=
AMAP_DEFAULT_REGION=福州
# 高德分类码：餐饮服务 / 住宿服务（可按高德控制台类目调整）
AMAP_FOOD_TYPES=050000
AMAP_HOTEL_TYPES=100000

# ---------- 外部 MCP 数据源：12306 车票查询（可选） ----------
# 需先启动 docker compose 服务 mcp-12306（drfccv/mcp-server-12306）。
# 上游为非官方聚合、仅供学习研究（不商用）；默认关，关闭时工具明确报未启用。
# 默认走 app 容器内的 compose 服务名；宿主机裸跑调试才改为
# http://127.0.0.1:18000/mcp（宿主机回环在容器内不可达）。
TRAIN_MCP_ENABLED=false
TRAIN_MCP_BASE_URL=http://mcp-12306:8000/mcp

# ---------- 外部 MCP 数据源：知乎搜索（可选，官方 MCP） ----------
# developer.zhihu.com 官方开放平台（个人中心生成 Access Secret，勿提交仓库）。
# 搜索类各有免费配额（按期重置），本地缓存/节流默认已按省配额调优。
# 关闭时工具明确报未启用，不影响其他链路。
ZHIHU_MCP_ENABLED=false
ZHIHU_MCP_API_KEY=

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json（生产推荐 json，含 trace_id）

# ---------- Tool 失败治理（core/tool_runtime，2026-09-22） ----------
# 请求级 Deadline（仅在线交互请求；Celery 后台任务不受约束）
BUSINESS_DEADLINE_S=30             # 请求端到端上限
WORKFLOW_DEADLINE_S=25             # 图执行（含 Tool）可用预算
REPORTER_RESERVED_S=5              # 给 Reporter 保留的尾款
TOOL_RUNTIME_ENABLED=true          # 紧急回滚开关：false 退回旧 60s×3 执行循环
TOOL_CB_FAILURE_THRESHOLD=5        # 连续失败 N 次 → 熔断 OPEN
TOOL_CB_RECOVERY_SECONDS=30        # OPEN 冷却秒数 → HALF_OPEN 探测
TOOL_BULKHEAD_WAIT_MS=300          # 并发隔离舱拿不到槽位的最长等待
# 按工具覆盖策略（JSON），例如 RAG 本地 pipeline 含 LLM 合成时调大超时：
# TOOL_POLICY_JSON={"rag.search": {"timeout_ms": 15000}, "sql.query": {"timeout_ms": 8000}}
TOOL_POLICY_JSON=

# ---------- 上下文预算管理 Context Budget（2026-09-22 Phase 5 生产硬化）----------
# 新机器不配置本节也能正常启动（全部有代码默认值）；管理端可热调模型绑定。
CONTEXT_BUDGET_ENABLED=true        # 总开关：false 关闭整套 L1-L5
LLM_CONTEXT_LENGTH=8192            # 配置上下文窗口（预算=min(此值, llm_models.context_length)）
CONTEXT_OUTPUT_RESERVE_TOKENS=768  # 输出预留
CONTEXT_SAFETY_RESERVE_TOKENS=256  # 安全余量
TOOL_INLINE_MAX_TOKENS=768         # L1 单条工具结果上限，超出降级预览
TOOL_PREVIEW_MAX_TOKENS=256        # L1 预览上限
PREVIOUS_OUTPUTS_MAX_TOKENS=1024   # L3 previous_outputs 总预算
HISTORY_TOKEN_BUDGET=2048          # memory 侧历史预算上限（STOP E 收口登记）

# ---------- Context Budget 计数口径（STOP D 标定收口 2026-09-23）----------
CONTEXT_TOKEN_ESTIMATION_MARGIN=1.10  # estimated 计数安全系数（宁高估不低估）
CONTEXT_MESSAGE_OVERHEAD_TOKENS=4     # 每条消息对话模板包裹开销
CONTEXT_IMAGE_TOKEN_ESTIMATE=1024     # 单张图片固定估算（VL 观察项，非计费口径）
CONTEXT_L4_TRIGGER_RATIO=0.80      # L4 折叠触发比例
CONTEXT_L4_TARGET_RATIO=0.65       # L4 压缩目标比例（滞回，未达则逐档收紧）
CONTEXT_L5_LOCK_TTL=60             # L5 Redis 单飞锁 TTL（须 > 摘要超时）
CONTEXT_L4_KEEP_RECENT_TURNS=4     # L4/L5 保留最近 N 轮原文
CONTEXT_L5_TRIGGER_RATIO=0.90      # L5 触发比例（最后一道防线）
CONTEXT_L5_TARGET_RATIO=0.70       # L5 压缩目标比例
CONTEXT_L5_ENABLED=true            # L5 kill switch：false 只关摘要 API，L1-L4 保持
CONTEXT_L5_SUMMARY_TIMEOUT_SECONDS=30  # 摘要 LLM 超时（按新模型 P95×2 校准）
CONTEXT_L5_SUMMARY_MAX_TOKENS=512  # 摘要输出上限
CONTEXT_L5_SUMMARY_TEMPERATURE=0.2 # 摘要低温
# 摘要模型：正式走 context_compactor 模型角色（DB 绑定 → 此常量兜底 → inherit main）
# 建议绑定低延迟 non-thinking 轻模型（如 qwen3.7-flash）
CONTEXT_L5_SUMMARY_MODEL=
CONTEXT_L5_MIN_DELTA_MESSAGES=2    # 少于该条数不触发摘要
CONTEXT_L5_MAX_DELTA_MESSAGES=200  # 单次摘要最多带多少条新消息
CONTEXT_L5_MAX_PROTECTED_FACTS=40  # ProtectedFacts 上限

# ---------- 聊天输入限制（Chat/RAG 收口 2026-09-22）----------
# 产品输入硬上限（与 LLM Context 预算是两回事）；前端计数器须与此对齐。
# 定位：Chat 承载较长问题/配置/代码片段/结构化需求；整份知识文档走 /api/rag/upload。
CHAT_INPUT_MAX_CHARS=20000         # 单条输入最大字符数（前后端一致）
CHAT_INPUT_MAX_BYTES=65536         # 请求体字节上限（UTF-8）
CHAT_INPUT_MAX_TOKENS=8000         # Input Guard token 上限（防滥用）
# 超限返回业务错误：code=INVALID_PARAM, details.reason=CHAT_INPUT_TOO_LARGE

# ── LLM 预算（2026-10-01 P0 治理后）──────────────────────────────
# 模式：off=不计数不阻断 / observe=只记录不阻断 / enforce=调用前硬预占
# 非法值启动即失败；ENVIRONMENT=production 时必须显式声明（不许缺省）
LLM_BUDGET_MODE=observe
# 请求级单次预占上限，单位 = 记账本位币 CNY（旧名 LLM_REQUEST_MAX_COST_USD 兼容读取）
#LLM_REQUEST_MAX_COST=0.50
# 记账本位币为 CNY；供应商美元报价按此汇率折算（1 USD = ? CNY）
BUDGET_FX_USD_CNY=7.20
# 预占滞留判定阈值（小时）：超过即转待对账（needs_review）
BUDGET_STALE_RESERVATION_HOURS=6
# 流式 usage 缺失时按本地字符统计估算结算（estimated），不进待对账；0=关闭回退原路径
LLM_USAGE_ESTIMATION_ENABLED=1
# 对账日报（每日自动跑）：窗口未决率超阈值且样本足够时出告警
BUDGET_RECONCILE_WINDOW_HOURS=24
BUDGET_RECONCILE_ALERT_RATIO=0.02
BUDGET_RECONCILE_ALERT_MIN_SAMPLES=20

# ---------- Prompt 发布评测分发 ----------
# 本地开发可显式选择 local；正式管理端发布默认使用 github。
PROMPT_EVAL_EXECUTOR=github
PROMPT_EVAL_GITHUB_REPOSITORY=
PROMPT_EVAL_GITHUB_WORKFLOW=prompt_eval.yml
PROMPT_EVAL_GITHUB_TOKEN=
PROMPT_EVAL_GITHUB_REF=main
# 后端 Celery 轮询 GitHub Run/Artifact 的间隔与最长尝试次数。
PROMPT_EVAL_POLL_INTERVAL_SECONDS=15
PROMPT_EVAL_POLL_MAX_ATTEMPTS=120
# 旧版签名回调接口仍保留兼容，但 prompt_eval.yml 默认不再主动回调。
PROMPT_EVAL_CALLBACK_SECRET=
PROMPT_EVAL_CALLBACK_TOLERANCE_SECONDS=300
# seed_prompt_eval_db.py 仅接受明确的测试库配置，不使用这些默认空值。
PROMPT_EVAL_TEST_PGDATABASE=agent_memory_test
PROMPT_EVAL_TEST_PROVIDER_ID=prompt-eval-test
PROMPT_EVAL_TEST_MODEL=
PROMPT_EVAL_TEST_BASE_URL=
PROMPT_EVAL_TEST_API_KEY=
