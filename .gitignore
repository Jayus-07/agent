# ============================================
# Agent AI Platform - Comprehensive .gitignore
# ============================================
# Purpose: Exclude unnecessary files to keep repository clean
#          and under GitHub's size limits
# 
# This covers:
# - Build artifacts & compiled code
# - Database files (SQLite, Chroma, etc.)  
# - Log files & temporary data
# - Cache directories
# - IDE/Editor configurations
# - Environment secrets
# - Test artifacts & coverage reports
# ============================================

# ============================================
# PYTHON BUILD ARTIFACTS
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================
# PYTEST & COVERAGE
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*coverage
.venv/
venv/
ENV/
pyenv.cfg

# ============================================
# DATABASE FILES (CRITICAL - EXCLUDE THESE!)
# ============================================
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
*.db-journal
data/*.db
data/*.sqlite
data/*.sqlite3
backend/data/*.db
backend/data/*.sqlite
trace_store.db
chroma.sqlite3
doc_registry.db
daily_reports.db
demo_sales.db
feedback.db
inventory_alerts.db
keyword_rules.db
selection.db
