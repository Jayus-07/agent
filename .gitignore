# ============================================
# FINAL CHECK
# ============================================
# Files that SHOULD be tracked but often aren't
# Add these to your project if needed:
# *.sql (database schema)
# *.yaml / *.yml (configuration)
# Dockerfile (container setup)
# docker-compose.yml (container orchestration)
# requirements*.txt (Python dependencies)
# pyproject.toml (Python config)

# ============================================
# RUNTIME ARTIFACTS & LOCAL TOOLS (2026-09-11)
# ============================================
# SQLite WAL/SHM 伴随文件（主 .db 文件按原有规则处理）
*.db-shm
*.db-wal
# 前端构建增量缓存
*.tsbuildinfo
# 本地 AI 工具目录
.qoder/
.workbuddy/
# 清理脚本产生的备份/隔离目录
data/_rag_clear_backup_*/
backend/data/_rag_clear_backup_*/
backend/data/_quarantine_damaged_*/
# 记忆库运行时数据目录（索引/向量库/上传文件，不进 git）
backend/data/
# LLM token 用量流水
token_usage.jsonl

# Java 构建产物与本地 agent 配置
business-service/target/
# 网关构建产物（P2 本地容器编译会生成；此前只忽略了 business-service 的 target）
api-gateway/target/
.zcode/

# 网关鉴权冒烟脚本的临时产物
.smoke_cookies.tmp
_smoke*.log

# 评测产物（运行时生成）
data/eval_reports/

# 跨项目一次性诊断脚本（属 Enterprise_OA，需读其 .env.oaauth 取口令，不入库）
scripts/_diag_*.py
