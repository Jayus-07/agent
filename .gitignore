# ============================================
node_modules/
.next/
.out/
dist/
dist-build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.npm
.npmrc
.npm-global
.yarn/
.pnpm-store/
.npm-cache/
