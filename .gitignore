.env
.env.local
.env.production
.env.development
.env.test
*.env.example
.env.*.local
*.key
*.pem
*.crt
secrets.json
credentials.json
aws_credentials.json
service-account.json
google-service-account.json
api_keys.txt
tokens.txt

