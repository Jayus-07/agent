eval_history.db
workflow_runs.db
chunk_store.db
competitor.db
database.db
report_preferences.json
doc_registry.sqlite3
data/chroma_market/
data/router_index/
data/cs_router_index/
data/eval_runs/
data/bm25/
data/doc_db/
data/long_term_memory/

# ============================================
# CHROMA VECTOR DATABASE CACHES
