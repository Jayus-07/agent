{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-*/types/**/*.ts",
    ".next-smoke/types/**/*.ts",
    ".next-dev-02413/types/**/*.ts",
    ".next-dev-103986008/types/**/*.ts",
    ".next-dev-1265116840/types/**/*.ts",
    ".next-dev-645517998/types/**/*.ts",
    ".next-dev-297125151/types/**/*.ts",
    ".next-dev-17123500/types/**/*.ts",
    ".next-dev-285701724/types/**/*.ts",
    ".next-dev-3268529199/types/**/*.ts",
    ".next-dev-10189883/types/**/*.ts",
    ".next-dev-145804828/types/**/*.ts",
    ".next-dev-275628361/types/**/*.ts",
    ".next-dev-277973370/types/**/*.ts",
    ".next-dev-1379320170/types/**/*.ts",
    ".next-phase0-batch2/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
