# 入库链路关键词提取固定走 DOC_LLM_MODEL=qwen2.5:3b，不随问答模型切换。
LLM_MODEL=MiniMax-M3
# 入库链路文档级关键词 LLM — 固定本地 Ollama，不随前端问答模型切换
# （不设此项会走 _LLMProxy 跟随 LLM_MODEL，问答切大模型后入库会变慢/超时）
DOC_LLM_MODEL=qwen2.5:3b
# 生成温度（RAG 场景建议 0.1，越稳定越好）
LLM_TEMPERATURE=0.1
# 上下文窗口（token 数，影响 RAG 能塞多少 chunk）
LLM_CONTEXT_LENGTH=8192

# ====================================
# API Keys
# ====================================
# DeepSeek API Key（https://platform.deepseek.com）
DEEPSEEK_API_KEY=sk-4d6fb45f3da3462a98398af22e8a7837

# ====================================
# 切片配置
# ====================================
# 默认切片大小（字符数）
CHUNK_SIZE=300
# 相邻切片重叠（字符数）
CHUNK_OVERLAP=30
# 综合文档切片大小（project/report/listing/faq 类型）
PROJECT_CHUNK_SIZE=1500
# 通用文档切片大小（fallback）
GENERAL_CHUNK_SIZE=1000
# 通用文档重叠大小
GENERAL_CHUNK_OVERLAP=100

# ====================================
# 检索配置
# ====================================
# BM25 关键词检索返回数量
BM25_SEARCH_K=10
# 混合检索（向量+BM25 RRF 融合后）返回数量
HYBRID_SEARCH_K=8
# Rerank 后返回 Top-K
RERANK_TOP_K=5
# Rerank 分数阈值（低于此分丢弃）
RERANK_SCORE_THRESHOLD=0.3
# Rerank Gate 门槛（单查询模式下降低，避免误拒）
RERANK_MIN_TOP1=0.25
RERANK_MIN_AVG=0.15
RERANK_MIN_GAP=0

# ====================================
# 数据库路径
# ====================================
# Chunk 级向量库 / 文档级向量库 / 文档目录 — 已由 backend/config/database.py 自动推导绝对路径，不再需要在 .env 中设置
# 默认知识库 ID
DEFAULT_KB_ID=default

# ====================================
# 日志
# ====================================
LOG_LEVEL=INFO
LOG_FILE=rag_system.log

# ====================================
# 超时（秒）
# ====================================
# LLM API 调用超时
LLM_REQUEST_TIMEOUT=30
# CrossEncoder Rerank 超时
RERANK_TIMEOUT=15
# 单次请求总超时（超 80% 触发告警）
OVERALL_REQUEST_TIMEOUT=60

# ====================================
# 特性开关
# ====================================
# 资源监控（CPU/内存告警）
ENABLE_RESOURCE_MONITOR=false
# 增量索引（SHA256 diff，跳过未修改文档）
ENABLE_INCREMENTAL_INDEXING=true
# 最大并发请求数（防止 CPU 过载）
MAX_CONCURRENT_REQUESTS=4

# PostgreSQL（双库）
# Memory 库：Agent 自身元数据 + 用户聊天/记忆（chat_sessions / chat_messages / memory_records / ai.*）
PGHOST=localhost
PGPORT=5432
PGDATABASE=agent_memory
PGUSER=postgres
PGPASSWORD=postgres_dev
# Business 库：业务数据仓库（product / order / inventory / customer / crawler / finance）
BUSINESS_PGDATABASE=agent_business
# Business 库只读账号（P0 安全加固：数据库层强制只读）
PG_READONLY_USER=agent_readonly
PG_READONLY_PASSWORD=agent_readonly_dev
# Business 库连接池（P0 性能加固）
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10
DB_CONNECT_TIMEOUT=5
DB_KEEPALIVES_IDLE=30

# RAG Evidence Gate：知识库文档少时关闭强制 doc_type 匹配
