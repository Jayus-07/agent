      },
      "description": "按 tool 外连接合并；Tool×Domain 组合多行时以首行为准",
      "targets": [
        {
          "expr": "sum by (tool, domain) (increase(agent_tool_calls_total[$__range]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "100 * sum by (tool) (increase(agent_tool_calls_total{status=\"success\"}[$__range])) / clamp_min(sum by (tool) (increase(agent_tool_calls_total[$__range])), 1e-07)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(agent_tool_latency_seconds_bucket[$__range])))",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(agent_tool_latency_seconds_bucket[$__range])))",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "sum by (tool) (increase(agent_tool_timeout_total[$__range]))",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "sum by (tool) (increase(agent_tool_retry_total[$__range]))",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "sum by (tool) (increase(agent_tool_fallback_total[$__range]))",
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "tool",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
