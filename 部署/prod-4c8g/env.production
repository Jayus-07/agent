# ============================================================================
# Agent Platform 生产环境变量 —— 4 vCPU / 8 GB RAM / 40 GB SSD
# 用法：cp env.production .env.production && 逐项替换 <...>；不要提交真实密钥。
# 与根 Compose、本目录 local 资源层及 4c8g 生产层配合使用（见 README.md）。
# ============================================================================

# ── 基础 ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
# 生产必须 false：未配置 API_KEY 时放行全部端点
ALLOW_UNAUTHENTICATED=false

# ── 必须替换的密钥（生成方式见 README §2）─────────────────────────────────
PGPASSWORD=<32位随机串>
REDIS_PASSWORD=<32位随机串>
AUTH_REDIS_PASSWORD=<32位随机串>
JWT_SECRET=<64位随机串>
SECRETS_ENCRYPTION_KEY=<Fernet key，python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())">
API_KEY=<32位随机串>
AI_INTERNAL_TOKEN=<32位随机串>

# ── 网关鉴权 ────────────────────────────────────────────────────────────────
GATEWAY_AUTH_ENABLED=true
GATEWAY_AUTH_MODE=enforce
JWT_ISSUER=agent-platform

# ── PostgreSQL（容器内 5432；宿主机不暴露公网）──────────────────────────────
PGHOST=postgres
PGPORT=5432
PGDATABASE=agent_memory
PGUSER=postgres
PG_READONLY_PASSWORD=<32位随机串>
# 4C8G 关键项：单进程池上限 2，配合 max_connections=120（见 postgresql.conf）
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=2
DB_CONNECT_TIMEOUT=10

# ── Celery 并发（4 vCPU 分配）──────────────────────────────────────────────
AGENT_WORKER_CONCURRENCY=2
RAG_INDEX_WORKER_CONCURRENCY=1
MAINTENANCE_WORKER_CONCURRENCY=1
REPORT_WORKER_CONCURRENCY=1
METADATA_SHADOW_WORKER_CONCURRENCY=1
# 本地 embedding 在 4C8G 上串行处理批次，避免并发推理抬高峰值内存。
EMBED_BATCH_CONCURRENCY=1
EMBEDDING_REBUILD_REQUEST_TIMEOUT=60
EMBEDDING_REBUILD_BATCH_SIZE=1
CELERY_BROKER_VISIBILITY_TIMEOUT=3900
# 全局请求闸门：单机 4C 使用 12，索引仍走独立单 worker 队列。
DIST_CONCURRENCY_ENABLED=true
DIST_MAX_CONCURRENT_REQUESTS=12
BUSINESS_DEADLINE_S=60
WORKFLOW_DEADLINE_S=55
REPORTER_RESERVED_S=5
DIST_TENANT_MAX_CONCURRENT=0

# ── RAG：独立检索服务，模型服务外置 ───────────────────────────────────────
# 模型角色、地址和凭据来自管理端数据库；不要在此覆盖模型身份。
RAG_MODE=remote
# 上传/索引限制：单文件 50MB；索引数据保留在 app_data 卷
RAG_MAX_FILE_SIZE=50
RAG_REINDEX_ASYNC_ENABLED=true

# ── 上下文与请求预算（8G 机器不要放开）────────────────────────────────────
LLM_CONTEXT_LENGTH=8192
CHAT_INPUT_MAX_CHARS=20000
CHAT_INPUT_MAX_TOKENS=8000
LLM_REQUEST_MAX_CALLS=8
LLM_REQUEST_MAX_TOKENS=32000
LLM_REQUEST_MAX_COST=0.50

# ── 模型供应商（真实密钥放数据库，由管理端配置）──────────────────────────
# 不要在 env 里写死厂商 API Key；管理端「模型与供应商」写库后由 registry 热加载。

# ── 备份与日志 ──────────────────────────────────────────────────────────────
# 40GB 磁盘：日志轮转 + 备份保留 7 天（见 compose 的 logging 段）
PG_BACKUP_RETENTION_DAYS=7

# ── 可观测性（4C8G 默认关闭；需要时改用外部 Prometheus）───────────────────
METRICS_ENABLED=true
