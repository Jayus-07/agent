# 真实链路测量脚本的容器环境变量模板（R0/R1-A 复现用）
#
# 用法：
#   1) 从运行中的 rag-service 容器导出真实环境（含凭据，切勿入库）：
#        docker inspect agent-rag-service-1 --format '{{range .Config.Env}}{{println .}}{{end}}' > artifacts/rag-perf-r0r1/rag-service.env
#   2) 运行测量（容器内直连真实 KB 与真实 provider）：
#        docker run --rm --network agent_agent-net \
#          --env-file artifacts/rag-perf-r0r1/rag-service.env \
#          -e PYTHONPATH=/app -e PYTHONDONTWRITEBYTECODE=1 -e PYTHONPYCACHEPREFIX=/tmp/pyc \
#          -v "$PWD/backend:/app/backend" \
#          -v "$PWD/artifacts/rag-perf-r0r1:/app/artifacts" \
#          -v agent_app_data:/app/data -v agent_app_cache:/app/.cache \
#          agent-rag-service:latest \
#          python /app/artifacts/measure_ask.py "退款审核时间是多少？" --kb default --repeat 3
#
# 说明：PYTHONDONTWRITEBYTECODE + PYTHONPYCACHEPREFIX 是为了避免镜像内旧
# __pycache__ 让挂载的新代码被跳过（本任务实测踩过该坑）。
RAG_MODE=local
ENV_MODE=cloud
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<从容器环境读取，切勿写入本文件>
PGDATABASE=agent_memory
REDIS_URL=<从容器导出>
