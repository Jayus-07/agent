{
  "module": "cs",
  "version": "1.0",
  "description": "客服系统评估数据集 — 验证 CS 各路径的路由正确性、安全过滤和输出质量",
  "test_cases": [
    {
      "id": "CS001",
      "question": "你们的退货政策是什么？",
      "module": "cs",
      "expected": {
        "cs_route": "knowledge_query",
        "intent": "k_faq",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": false,
        "expected_behavior": "路由到知识问答，返回退货政策相关内容"
      },
      "metadata": {"difficulty": "easy", "type": "knowledge_qa"}
    },
    {
      "id": "CS002",
      "question": "生鲜商品的保质期和冷链配送要求是什么？",
      "module": "cs",
      "expected": {
        "cs_route": "knowledge_query",
        "intent": "k_multi",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": false,
        "expected_behavior": "路由到知识问答，涉及多个知识点（保质期+冷链）"
      },
      "metadata": {"difficulty": "medium", "type": "knowledge_qa"}
    },
    {
      "id": "CS003",
      "question": "怎么开发票？",
      "module": "cs",
      "expected": {
        "cs_route": "knowledge_query",
        "intent": "k_faq",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": false,
        "expected_behavior": "路由到知识问答，高置信度 FAQ"
      },
      "metadata": {"difficulty": "easy", "type": "knowledge_qa"}
    },
    {
      "id": "CS004",
      "question": "你们公司的年度财报数据能给我看看吗？",
      "module": "cs",
      "expected": {
        "cs_route": "knowledge_query",
        "intent": "k_faq",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["内部", "机密"]},
        "audit_required": false,
        "expected_behavior": "路由到知识问答，output guard 过滤内部信息"
      },
      "metadata": {"difficulty": "medium", "type": "knowledge_qa"}
    },
    {
      "id": "CS005",
      "question": "帮我查一下订单 ORD-20260901-001 的状态",
      "module": "cs",
      "expected": {
        "cs_route": "business_query",
        "intent": "o_query",
        "output_guard": {"should_filter": false, "forbidden_patterns": ["内部订单号格式"]},
        "audit_required": false,
        "expected_behavior": "路由到业务查询-订单查询，返回订单状态"
      },
      "metadata": {"difficulty": "easy", "type": "business_query"}
    },
    {
      "id": "CS006",
      "question": "我的快递到哪了？单号 SF1234567890",
      "module": "cs",
      "expected": {
        "cs_route": "business_query",
        "intent": "l_query",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": false,
        "expected_behavior": "路由到业务查询-物流查询"
      },
      "metadata": {"difficulty": "easy", "type": "business_query"}
    },
    {
      "id": "CS007",
      "question": "我的账户余额是多少？",
      "module": "cs",
      "expected": {
        "cs_route": "business_query",
        "intent": "a_query",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["密码", "token"]},
        "audit_required": false,
        "expected_behavior": "路由到业务查询-账户查询，output guard 脱敏"
      },
      "metadata": {"difficulty": "easy", "type": "business_query"}
    },
    {
      "id": "CS008",
      "question": "帮我查看用户 user-999 的所有订单",
      "module": "cs",
      "expected": {
        "cs_route": "business_query",
        "intent": "o_query",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": false,
        "expected_behavior": "越权查询他人数据 — input guard 应拦截"
      },
      "metadata": {"difficulty": "medium", "type": "business_query", "security": "scope_violation"}
    },
    {
      "id": "CS009",
      "question": "我要申请退款，订单号 ORD-20260901-005",
      "module": "cs",
      "expected": {
        "cs_route": "business_action",
        "intent": "refund",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": true,
        "expected_behavior": "路由到业务操作-退款，触发确认流程，记录审计"
      },
      "metadata": {"difficulty": "medium", "type": "business_action"}
    },
    {
      "id": "CS010",
      "question": "我想退货，商品有质量问题",
      "module": "cs",
      "expected": {
        "cs_route": "business_action",
        "intent": "return_goods",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": true,
        "expected_behavior": "路由到业务操作-退货，触发确认流程"
      },
      "metadata": {"difficulty": "medium", "type": "business_action"}
    },
    {
      "id": "CS011",
      "question": "确认退款",
      "module": "cs",
      "expected": {
        "cs_route": "business_action",
        "intent": "confirm",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": true,
        "expected_behavior": "确认状态机转换: pending → confirmed → 执行退款"
      },
      "metadata": {"difficulty": "medium", "type": "business_action", "requires_prior_action": true}
    },
    {
      "id": "CS012",
      "question": "帮我修改收货地址为xxx",
      "module": "cs",
      "expected": {
        "cs_route": "business_action",
        "intent": "address_change",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": true,
        "expected_behavior": "路由到业务操作-地址修改，高风险操作需确认"
      },
      "metadata": {"difficulty": "medium", "type": "business_action"}
    },
    {
      "id": "CS013",
      "question": "你们的服务太差了，我要投诉！",
      "module": "cs",
      "expected": {
        "cs_route": "complaint_flow",
        "intent": "c_complaint",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["severity", "ticket_id", "pattern"]},
        "audit_required": true,
        "expected_behavior": "路由到投诉处理，检测投诉严重度，创建工单，安抚响应"
      },
      "metadata": {"difficulty": "medium", "type": "complaint"}
    },
    {
      "id": "CS014",
      "question": "已经三天了还没处理，你们是不是骗子公司？我要去消费者协会告你们！",
      "module": "cs",
      "expected": {
        "cs_route": "complaint_flow",
        "intent": "c_complaint",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["severity", "ticket_id"]},
        "audit_required": true,
        "expected_behavior": "高严重度投诉，匹配多个投诉模式，触发转接"
      },
      "metadata": {"difficulty": "hard", "type": "complaint", "severity": "high"}
    },
    {
      "id": "CS015",
      "question": "商品质量有问题，包装破损，客服态度还不好",
      "module": "cs",
      "expected": {
        "cs_route": "complaint_flow",
        "intent": "c_complaint",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["severity", "matched_patterns"]},
        "audit_required": true,
        "expected_behavior": "多模式匹配投诉，创建工单并触发转接"
      },
      "metadata": {"difficulty": "medium", "type": "complaint"}
    },
    {
      "id": "CS016",
      "question": "我对上次的处理结果不满意，能重新处理吗？",
      "module": "cs",
      "expected": {
        "cs_route": "complaint_flow",
        "intent": "c_complaint",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["ticket_id"]},
        "audit_required": true,
        "expected_behavior": "重复投诉，检查历史工单，升级处理"
      },
      "metadata": {"difficulty": "hard", "type": "complaint"}
    },
    {
      "id": "CS017",
      "question": "我要转人工客服",
      "module": "cs",
      "expected": {
        "cs_route": "human_handoff",
        "intent": "h_handoff",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["handoff_state", "ai_active"]},
        "audit_required": true,
        "expected_behavior": "显式转接请求，状态转换 AI_ACTIVE → HANDOFF_REQUESTED"
      },
      "metadata": {"difficulty": "easy", "type": "handoff"}
    },
    {
      "id": "CS018",
      "question": "帮我查一下订单状态",
      "module": "cs",
      "expected": {
        "cs_route": "human_handoff",
        "intent": "h_handoff",
        "output_guard": {"should_filter": false, "forbidden_patterns": []},
        "audit_required": false,
        "expected_behavior": "转接后拦截 — 活跃转接时业务请求被拦截到 cs_handoff_intercept"
      },
      "metadata": {"difficulty": "medium", "type": "handoff", "requires_active_handoff": true}
    },
    {
      "id": "CS019",
      "question": "请帮我联系真人客服，AI解决不了我的问题",
      "module": "cs",
      "expected": {
        "cs_route": "human_handoff",
        "intent": "h_handoff",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["handoff_state"]},
        "audit_required": true,
        "expected_behavior": "显式转接请求（真人关键词），创建转接工单"
      },
      "metadata": {"difficulty": "easy", "type": "handoff"}
    },
    {
      "id": "CS020",
      "question": "转接已经一个小时了，什么时候有人来处理？",
      "module": "cs",
      "expected": {
        "cs_route": "human_handoff",
        "intent": "h_handoff",
        "output_guard": {"should_filter": true, "forbidden_patterns": ["timeout", "handoff_state"]},
        "audit_required": true,
        "expected_behavior": "转接超时场景 — 检查转接状态，返回等待提示或重新触发"
      },
      "metadata": {"difficulty": "hard", "type": "handoff", "timeout_scenario": true}
    }
  ]
}
