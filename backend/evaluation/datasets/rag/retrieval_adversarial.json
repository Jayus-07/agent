        "match_type": "snippet"
      },
      "metadata": {
        "difficulty": "medium",
        "domain": "inventory",
        "query_type": "adversarial",
        "tier": "core",
        "answer_type": "numeric",
        "expected_answer": "苹果水果入库糖度≥13°",
        "must_contain": ["糖度", "13"],
        "probe_type": "word_disambiguation",
        "probe_note": "25_同形异义词.md 第二篇水果Apple，期望召回水果章节（同文档不同chunk）",
        "ground_truth_verified": true
      }
    },
    {
      "id": "V2-ADV-004",
      "question": "海运拼箱的运费单价是多少？",
      "module": "rag",
      "kb_id": "rag_test_kb",
      "expected": {
        "relevant_docs": ["ba8721e79b"],
        "relevant_snippets": ["海运拼箱", "8.00"],
        "match_type": "snippet"
      },
      "metadata": {
        "difficulty": "medium",
        "domain": "logistics",
        "query_type": "adversarial",
        "tier": "hard",
        "answer_type": "numeric",
        "expected_answer": "海运拼箱人民币8.00元/kg，最低消费50元",
        "must_contain": ["8.00"],
        "probe_type": "numeric_sensitivity",
        "probe_note": "26_数字近似陷阱.md 三档运费都是8元但写法不同(8/8.00/¥8)；期望精确召回海运拼箱段(8.00元)而非空运/专线",
        "ground_truth_verified": true
      }
    },
    {
      "id": "V2-ADV-005",
