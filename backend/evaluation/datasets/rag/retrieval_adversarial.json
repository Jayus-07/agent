{
  "version": "2.0",
  "_comment": "V2.0 对抗性检索评测 — 标题党、关键词干扰、同形异义词、数字近似陷阱等。验证系统不被表面相似性误导。",
  "test_cases": [
    {
      "id": "V2-ADV-001",
      "question": "跨境电商退货流程是怎样的？",
      "module": "rag",
      "kb_id": "rag_test_kb",
      "expected": {
        "relevant_docs": ["f938bc1033"],
        "relevant_snippets": ["7天", "退货政策"],
        "match_type": "snippet"
      },
      "metadata": {
        "difficulty": "medium",
        "domain": "return_policy",
        "query_type": "adversarial",
        "tier": "core",
        "answer_type": "procedural",
        "expected_answer": "签收后7天内可申请退货，需满足商品不影响二次销售",
        "must_contain": ["7天"],
        "probe_type": "title_distraction",
        "probe_note": "24_关键词干扰文档.md 标题含'退货流程'但内容是促销活动；期望召回真实退货政策(f938bc1033)而非干扰文档",
        "ground_truth_verified": true
      }
    },
    {
      "id": "V2-ADV-002",
      "question": "Apple Watch 包装盒有什么标签要求？",
      "module": "rag",
      "kb_id": "rag_test_kb",
      "expected": {
        "relevant_docs": ["7fae54d9ff"],
        "relevant_snippets": ["序列号", "IP6X"],
        "match_type": "snippet"
      },
      "metadata": {
        "difficulty": "medium",
        "domain": "product_spec",
        "query_type": "adversarial",
        "tier": "core",
        "answer_type": "factual",
        "expected_answer": "Apple Watch包装盒标签要求序列号12位、防水等级IP6X",
        "must_contain": ["序列号", "IP6X"],
        "probe_type": "word_disambiguation",
        "probe_note": "25_同形异义词.md 含Apple电子产品和水果两篇；期望召回电子产品章节而非水果章节",
        "ground_truth_verified": true
      }
    },
    {
      "id": "V2-ADV-003",
      "question": "苹果水果入库糖度要求是多少？",
