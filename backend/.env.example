# 数据库（PostgreSQL）
PGHOST=localhost
PGPORT=5432
PGDATABASE=demo
PGUSER=postgres
PGPASSWORD=***REMOVED-LEAKED-PG-PASSWORD***

# 数据采集中心
DC_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/demo

# 模型路径（HuggingFace model name，自动走缓存）
EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
RERANKER_MODEL_PATH=BAAI/bge-reranker-base

# Ollama 本地服务（Qwen 系列走这里；AVAILABLE_MODELS 里 qwen2.5:3b 已注册）
# 用途：评测归因 / chunk 级 LLM 关键词（CHUNK_LLM_MODEL）等本地推理场景。
# 默认 http://localhost:11434，可改成远程 Ollama 地址（如团队 GPU 服务器）。
# 注意：
#   1. 仅用于本地推理场景。生产环境的 LLM 主调用链（Planner/Generator/Judge）
#      默认走 DeepSeek（LLM_MODEL=deepseek-v4-flash），不受 OLLAMA_BASE_URL 影响。
#   2. 修改后需重启 backend，Ollama 客户端缓存不生效。
#   3. 远程 Ollama 防火墙需放行 11434 端口。
#   4. 验证连通性: curl http://localhost:11434/api/tags
OLLAMA_BASE_URL=http://localhost:11434

# 日志格式: text (默认) | json (生产推荐，含 trace_id)
LOG_FORMAT=text
