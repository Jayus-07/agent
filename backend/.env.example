# ============================================================
# 环境变量模板（示例值，非生效配置）
#
# ⚠️ 本文件只是模板：实际生效的配置是**仓库根的 `.env`**
#    （backend/config/__init__.py 写死 _ENV_PATH = <repo_root>/.env）。
#    backend/.env 不会被加载，请勿把真实凭据写进任何被 git 跟踪的文件。
# 用法: cp backend/.env.example .env  然后按需填写
# ============================================================

# 数据库（PostgreSQL）
PGHOST=localhost
PGPORT=5432
PGDATABASE=demo
PGUSER=postgres
PGPASSWORD=change_me_local_pg_password   # 勿填真实口令；本文件为模板

# 数据采集中心
DC_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/demo

# ============================================================
# Runtime Mode (P0 Architecture Refactor)
# ============================================================
ENV_MODE=cloud  # "cloud" | "local"

# Cloud Mode: Use DashScope APIs
# ------------------------------------------------
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=  # Required for ENV_MODE=cloud

RERANK_MODEL=qwen3-rerank

# Local Mode: Use HuggingFace Models
# ------------------------------------------------
EMBEDDING_MODEL_PATH=BAAI/bge-small-zh-v1.5
RERANKER_MODEL_PATH=BAAI/bge-reranker-base

# Ollama 本地服务（仅显式选择 Ollama 模型时使用；qwen2.5:3b 不再是评测默认值）
# 用途：显式本地评测 / chunk 级 LLM 关键词（CHUNK_LLM_MODEL）等本地推理场景。
# 默认 http://localhost:11434，可改成远程 Ollama 地址（如团队 GPU 服务器）。
# 注意：
#   1. 仅用于本地推理场景。生产环境的 LLM 主调用链（Planner/Generator/Judge）
#      默认走 DeepSeek（LLM_MODEL=deepseek-v4-flash），不受 OLLAMA_BASE_URL 影响。
#   2. 修改后需重启 backend，Ollama 客户端缓存不生效。
#   3. 远程 Ollama 防火墙需放行 11434 端口。
#   4. 验证连通性: curl http://localhost:11434/api/tags
OLLAMA_BASE_URL=http://localhost:11434
EVAL_GEN_MODEL=

# 日志格式: text (默认) | json (生产推荐，含 trace_id)
LOG_FORMAT=text

# ============================================================
# Langfuse LLM observability (self-hosted, docker-compose.langfuse.yml)
# UI: http://localhost:3001  (admin@agent.local / Admin123456)
# ============================================================
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-agent-rag-local
LANGFUSE_SECRET_KEY=sk-lf-agent-rag-local

# ============================================================
# P0 结构化分析层（免 Docker 本地开发：SQLite data/analytics.db）
# 总开关；测试环境置 false。将来切 Postgres：OBS_BACKEND=postgres
# ============================================================
OBS_ANALYTICS_ENABLED=true

# ============================================================
# Redis（可选，默认关闭；开启后用于分布式缓存/限流/异步队列）
# ============================================================
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=agent:
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5

# ============================================================
# Token Usage Tracking (P0)
# ============================================================
TOKEN_USAGE_LOG_PATH=data/token_usage.jsonl

# Evaluation Dataset Path (P0)
EVAL_DATASET_PATH=  # Empty string for default path

# ============================================================
# 微服务（Java business-service + Kafka 事件总线）
# 见 docs/architecture-overview.md 与 docs/contracts/events.schema.json
# ============================================================
# Kafka 事件发布（默认关闭；compose 模式置 true）
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
# WhatsApp 入站消息消费（WhatsApp 闭环，独立于发布开关）
KAFKA_CONSUMER_ENABLED=false
# business-service 地址与内部令牌
BUSINESS_SERVICE_URL=http://127.0.0.1:8081
INTERNAL_API_TOKEN=
# cutover 开关：读源（cs_admin 代理）与写权（状态转换/消息落库）
CS_ADMIN_SOURCE=local
CS_WRITE_SOURCE=local
# Java→Python 工具网关（/internal/ai/*）
AI_INTERNAL_TOKEN=
AI_TOOLS_ENABLED=false
AI_TOOLS_ALLOWED=sql_query,list_tables,search_knowledge,list_documents

# ============================================================
# 腾讯位置服务（腾讯地图 LBS WebService API）
# 申请入口：https://lbs.qq.com/  → 控制台 → 应用管理 → 创建应用 → 添加 Key
# 创建时务必勾选「WebServiceAPI」，并建议按需勾选静态图等子服务。
# ============================================================
# 开发者密钥（6 段式，填入 TENCENT_LBS_KEY，勿写真实值进本文件）
# 仅服务端使用：前端一律经 /map/* 代理，绝不接触该 Key。
# 未配置时地图能力自动降级，不影响主链路。
TENCENT_LBS_KEY=
# 签名密钥 SK：仅当控制台开启「签名校验(SN)」时才需要填写；留空即不签名
TENCENT_LBS_SK=
# 总开关（默认 true）；实际生效条件为「开关开启 且 Key 非空」
TENCENT_LBS_ENABLED=true
# 默认检索城市：未指定地域时用它兜底，否则会返回全国范围的噪声结果
TENCENT_LBS_DEFAULT_REGION=福州
# 客户端最小请求间隔（秒），0.2 ≈ 5 QPS，与个人 Key 并发上限对齐
TENCENT_LBS_MIN_INTERVAL=0.2
# 结果缓存（地理编码/行政区划这类结果短期不变，缓存能显著节省日配额）
TENCENT_LBS_CACHE_ENABLED=true
TENCENT_LBS_CACHE_TTL=600
# 路线结果带实时路况，TTL 刻意取短
TENCENT_LBS_ROUTE_CACHE_TTL=120
# 旅行域是否使用真实路径规划与 POI 数据（关闭则沿用本地直线估算）
TRAVEL_USE_LIVE_MAP=false
# 前端专用 Key：用于「Key 必须进浏览器」的能力（URI API 地图调起、JS API 渲染）。
# 应与上面的后端 Key 分开申请，并配 Referer 域名白名单，避免后端配额被盗用。
# 留空时 /map/navigate 回退用后端 Key 并在响应里带 warning（不可外发）。
TENCENT_LBS_FRONTEND_KEY=
# URI API 调起的 referer 标识（腾讯必填，任意短字符串）
TENCENT_LBS_REFERER=agent-platform
# 天气：实时/逐小时 5 分钟，未来预报 30 分钟
TENCENT_LBS_WEATHER_TTL=300
TENCENT_LBS_FORECAST_TTL=1800
# ── 附加服务开通情况（与代码无关，仅作提醒）──
# · 天气：创建 Key 时勾选即可，无需额外申请
# · 街景：**申请制**，仅对企业开发者开放。需按官方配额申请模板（邮件正文格式）
#   发至 mapapi@vip.qq.com 并抄送 mapbd@tencent.com，约 3 个工作日审批。
#   未开通时接口返回 113「此功能未被授权」，代码会把申请路径带回给调用方。
# · 导航：腾讯**没有 Web 端导航 SDK**，Android/iOS 导航SDK 为原生库；
#   网页端走 URI API 调起腾讯地图 App（即 /map/navigate）。

# ---------- Tool 失败治理（core/tool_runtime，2026-09-22） ----------
# 请求级 Deadline（仅在线交互请求；Celery 后台任务不受约束）
BUSINESS_DEADLINE_S=30             # 请求端到端上限
WORKFLOW_DEADLINE_S=25             # 图执行（含 Tool）可用预算
REPORTER_RESERVED_S=5              # 给 Reporter 保留的尾款
TOOL_RUNTIME_ENABLED=true          # 紧急回滚开关：false 退回旧 60s×3 执行循环
TOOL_CB_FAILURE_THRESHOLD=5        # 连续失败 N 次 → 熔断 OPEN
TOOL_CB_RECOVERY_SECONDS=30        # OPEN 冷却秒数 → HALF_OPEN 探测
TOOL_BULKHEAD_WAIT_MS=300          # 并发隔离舱拿不到槽位的最长等待
# 按工具覆盖策略（JSON），例如 RAG 本地 pipeline 含 LLM 合成时调大超时：
# TOOL_POLICY_JSON={"rag.search": {"timeout_ms": 15000}, "sql.query": {"timeout_ms": 8000}}
TOOL_POLICY_JSON=

# ---------- Celery Worker 拓扑（Phase2 Step5：五 workload 五 worker）----------
# 队列名（compose 与 backend/config/tasks.py 同名 env；改队列名须同步重建全部 worker）
CELERY_AGENT_QUEUE=agent                    # interactive_agent 物理队列
CELERY_RAG_INDEX_QUEUE=rag_index            # rag_index 物理队列
CELERY_METADATA_SHADOW_QUEUE=rag_metadata_shadow
CELERY_MAINTENANCE_QUEUE=maintenance        # beat 扫描/收尸/补偿/探测
CELERY_REPORT_QUEUE=report                  # 报表长任务
# per-workload 并发（依据见 docs/2026-09-24-Phase2-Step5-Worker-Topology-验收报告.md）
AGENT_WORKER_CONCURRENCY=4                  # IO-bound，latency 优先
RAG_INDEX_WORKER_CONCURRENCY=2              # CPU/RAM 重（每子进程懒加载一份模型内存）
METADATA_SHADOW_WORKER_CONCURRENCY=2        # 保持既有默认
MAINTENANCE_WORKER_CONCURRENCY=1            # 原子幂等扫描，并行无益
REPORT_WORKER_CONCURRENCY=1                 # 低频长任务，隔离即可

# ---------- 客服域图开关 ----------
# Supervisor 信号门：风险兜底拦截（越权/注入拒答）+ 投诉直通（纯规则零 LLM）
CS_SIGNAL_GATE_ENABLED=true
# Supervisor 决策 v2：七层固定优先级（false 一键回退 v1 存量裁决顺序）
CS_DECISION_V2=true

# ---------- 旅游域图 ----------
# 理解层 LLM 兜底（灰度开关，默认 false）：词表分类器不认识的消息才交 LLM 补判 intent
TRAVEL_LLM_INTENT_ENABLED=false
TRAVEL_LLM_INTENT_TIMEOUT_MS=3000           # 单次 LLM 补判限时（毫秒，代码下限 500）
# 区县级天气（默认 true）：景点质心→逆地理反查区县→区县预报；解析失败回退城市级
TRAVEL_WEATHER_DISTRICT_ENABLED=true

# ---------- 图状态持久化（checkpointer） ----------
# 生产 PG 不可用时：false=拒启不降级（fail-closed，避免悄悄退化成内存检查点
# 丢跨轮状态）；确要接受降级的部署显式置 true 走 MemorySaver
CHECKPOINTER_ALLOW_DEGRADE=false

# ---------- Context Budget L5 ----------
CONTEXT_L5_ONLINE_WAIT_SECONDS=8            # 在线等待同轮摘要完成的时限（秒），超时降级用旧历史

# ---------- 评测运行台账（ai.eval_run_records） ----------
EVAL_RUN_HEARTBEAT_STALE_SECONDS=600        # 心跳超时判定阈值（秒），超时视为 run 已死允许接管/收尸
EVAL_STRICT_FIELDS=                         # 严格字段校验（默认关）：开启后缺 question/expected_answer/ground_truth 的评测集拒绝启动

# ---------- 分布式并发准入门（多副本部署才需要） ----------
# Redis 全局并发硬上限（多副本共享槽位）；单副本无需开启——进程内并发门已覆盖，
# 关闭时零 Redis 访问。Redis 不可用 fail-open（进程内门兜底）。
DIST_CONCURRENCY_ENABLED=false
DIST_MAX_CONCURRENT_REQUESTS=50             # 全局并发上限（跨全部副本合计）
DIST_TENANT_MAX_CONCURRENT=0                # 租户级上限（按 tenant_id 分桶）；0=不启用
DIST_GATE_LEASE_TTL_SECONDS=30              # 槽位租约 TTL（秒）：持槽进程崩溃后由后续 acquire 顺带回收

# ---------- RAG 重索引任务化 ----------
# 代码默认 false（本机同步执行）；docker compose 已强制 true——重索引提交幂等
# Celery 任务进 rag_index 队列执行，API 侧以 reindex/status 轮询
RAG_REINDEX_ASYNC_ENABLED=true

# ---------- Prompt 发布双门禁灰度 ----------
# 取值 off/audit/enforce（默认 audit）：audit=计算并落痕不拦截，
# enforce=门禁失败拒绝发布（409 fail-closed），off=完全跳过
PROMPT_RELEASE_REGRESSION_GATE_ENABLED=audit
PROMPT_RELEASE_RAGAS_GATE_ENABLED=audit
