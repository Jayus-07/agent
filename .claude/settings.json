{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(mkdir *)",
      "Bash(rmdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(psql *)",
      "Bash(PGPASSWORD=*)",
      "Bash(netstat *)",
      "Bash(powershell.exe -Command *)",
      "Bash(where *)",
      "Bash(which *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(tasklist *)",
      "Bash(code *)",
      "Bash(wget *)",
      "Bash(pytest *)",
      "Bash(true)",
      "Bash(false)",
      "Bash(sleep *)",
      "Bash(for *; do *; done)",
      "Bash(export *)",
      "Bash(pwd)",
      "Bash(date)",
      "Bash(seq *)",
      "Bash(cd *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git stash *)",
      "Bash(git reset *)",
      "Bash(git remote *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(python -m api.server)",
      "Bash(python multi_agent/demo.py)",
      "Bash(cd * && python *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf .git*)",
      "Bash(shutdown *)",
      "Bash(reboot *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows --repo \"D:/Program Files/workplace/agent\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cat >/dev/null || true; git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status --repo \"D:/Program Files/workplace/agent\" || echo 'Not a git repo, skipping'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "powershell.exe -Command \"if (-not (Get-NetTCPConnection -LocalPort 5555 -ErrorAction SilentlyContinue)) { Start-Process -WindowStyle Hidden -FilePath 'D:\\Program Files\\workplace\\agent\\.venv\\Scripts\\python.exe' -ArgumentList '-m','code_review_graph','serve','--http','--repo','D:\\Program Files\\workplace\\agent','--port','5555' }\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
